    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.21",
    "@carbon/charts-react": "^1.27.21",
    "@carbon/icons-react": "^11.90.0",
    "@carbon/react": "^1.118.0",
    "@cloudcompass/mock-data": "workspace:*",
    "@cloudcompass/types": "workspace:*",
    "@ibm/plex": "6.4.1",
    "@tanstack/react-query": "^5.104.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudcompass/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "typescript": "~5.9.3",
